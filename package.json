{
  "name": "huxy-admin",
  "version": "1.7.1",
  "type": "module",
  "description": "Customizable admin template for efficient and convenient development of maintainable and scalable systems, providing customized software design and development.",
  "keywords": [
    "react",
    "low-code",
    "web-design",
    "scene-design",
    "json schema",
    "web3",
    "webgl",
    "webpack",
    "full-stack",
    "MERN",
    "customizable",
    "responsive",
    "admin",
    "template",
    "chatgpt",
    "AIGC",
    "llm",
    "langchain"
  ],
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "scripts": {
    "postinstall": "husky install",
    "start": "pack start",
    "build": "pack run build",
    "analyze": "pack run analyze",
    "server": "pack run server",
    "test": "pack test",
    "release": "pack release",
    "eslint": "pack eslint 'app/**/*.{js,jsx}'",
    "stylelint": "pack stylelint 'app/**/*.{css,less}'",
    "lint": "npm run eslint && npm run stylelint",
    "lint-fix": "pack eslint --fix 'app/**/*.{js,jsx}' && pack stylelint --fix 'app/**/*.{css,less}'",
    "prettier": "pack prettier 'app/**/*' --write --ignore-unknown && npm run lint-fix",
    "server-fix": "pack eslint --fix 'server/**/*.{js,jsx,mjs}'",
    "server-pre": "pack prettier 'server/**/*' --write --ignore-unknown && npm run server-fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahyiru/huxy-admin"
  },
  "license": "MIT",
  "devDependencies": {
    "@huxy/pack": "1.6.11",
    "husky": "^9.1.6",
    "webpack-deadcode-plugin": "^0.1.17"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@huxy/components": "^2.1.17",
    "@huxy/layout": "^2.1.11",
    "@huxy/materials": "^1.1.6",
    "@huxy/router": "^2.1.12",
    "@huxy/use": "^2.1.11",
    "@huxy/utils": "^2.1.14",
    "antd": "^5.21.6",
    "qrcode": "^1.5.4",
    "react": "19.0.0-rc-33c7bd9a-20241104",
    "react-dom": "19.0.0-rc-33c7bd9a-20241104",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "react-window-infinite-loader": "^1.0.9"
  }
}
